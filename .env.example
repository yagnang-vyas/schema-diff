# Fake, local-only credentials for the docker compose databases.
# Copy to .env (git-ignored): cp .env.example .env
POSTGRES_PASSWORD=pg_local_only_pw
MYSQL_ROOT_PASSWORD=mysql_local_only_pw

# Used by `make test` / `make test-integration`. These are administrative URLs:
# the tests create and drop the drift_* schemas with them. SchemaDiff itself only reads.
SCHEMADIFF_PG_URL=postgresql+psycopg://schemadiff:pg_local_only_pw@127.0.0.1:55432/schemadiff
SCHEMADIFF_MYSQL_URL=mysql+pymysql://root:mysql_local_only_pw@127.0.0.1:53306/schemadiff
